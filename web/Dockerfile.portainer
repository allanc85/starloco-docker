# Imagem do site para o Portainer: igual a web/Dockerfile, com o site e o cliente embutidos.
FROM php:8.3-fpm-alpine

RUN apk add --no-cache \
    nginx \
    curl \
    bash \
    php83 \
    php83-fpm \
    php83-session \
    php83-pdo \
    php83-pdo_mysql \
    php83-pdo_sqlite \
    php83-sqlite3 \
    php83-mysqli \
    php83-mbstring \
    php83-gd \
    php83-zip \
    php83-opcache \
    php83-intl \
    php83-curl \
    php83-json \
    mariadb-client \
    zip

RUN mkdir -p /var/www/web /var/www/adminer /var/www/dofus /var/www/data /run/php /var/log/nginx

RUN set -eux; \
    for conf in /etc/php83/php-fpm.d/www.conf /usr/local/etc/php-fpm.d/www.conf; do \
        if [ -f "$conf" ]; then \
            sed -i 's/^user = .*/user = www-data/' "$conf"; \
            sed -i 's/^group = .*/group = www-data/' "$conf"; \
        fi; \
    done

COPY php.ini /usr/local/etc/php/php.ini
COPY nginx.portainer.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
COPY entrypoint-portainer.sh /entrypoint-portainer.sh
COPY gerar-cliente.sh /usr/local/bin/gerar-cliente.sh

# Site (normalmente montado de ./web/public) e cliente Windows 1.39.8 embutidos na imagem
COPY public /src/public
COPY dofus /opt/dofus-client

RUN chmod +x /entrypoint.sh /entrypoint-portainer.sh /usr/local/bin/gerar-cliente.sh

RUN chown -R www-data:www-data /var/www

EXPOSE 80

ENTRYPOINT ["/entrypoint-portainer.sh"]
